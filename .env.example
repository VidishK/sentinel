# CockroachDB Cloud
# From: ccloud cluster sql <cluster> --connection-string
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# Cluster identity, used by the backup guard via the ccloud CLI
CCLOUD_CLUSTER_NAME=sentinel

# AWS / Bedrock
AWS_REGION=us-east-1
# Use an inference profile ID for Claude (on-demand model IDs are rejected).
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=1024

# S3 bucket for change diffs and trial artifacts
ARTIFACT_BUCKET=sentinel-artifacts-CHANGEME

# Safety thresholds for the risk classifier
RISK_ROWS_HIGH=1000
RISK_ROWS_MEDIUM=100

# Auth. Get a free key at https://resend.com — signup emails actually send.
# Until you verify a domain, from must be onboarding@resend.dev and to must be
# the email on your Resend account.
RESEND_API_KEY=
AUTH_FROM_EMAIL=Sentinel <onboarding@resend.dev>
GOOGLE_CLIENT_ID=
AUTH_PUBLIC_URL=http://127.0.0.1:5173
AUTH_DEV_MODE=true
